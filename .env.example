# Credenciales - copia a .env y completa
# GROQ_API_KEY de https://console.groq.com/ > API Keys (gsk_..., gratis)
GROQ_API_KEY=""

# Modelos del curso (GUIA_DEL_ESTUDIANTE.md): 120b razonamiento final, 20b loops/dev
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_MODEL_FAST="openai/gpt-oss-20b"

# Embeddings locales (sin API; primera descarga ~470MB)
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
